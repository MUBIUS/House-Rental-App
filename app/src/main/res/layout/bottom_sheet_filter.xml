<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/layout_bg"
    android:padding="20dp">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/grey_300"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filters"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"/>

        <TextView
            android:id="@+id/tv_clear_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_filters"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Property Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/property_type"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_property_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                android:layout_marginBottom="20dp">
                <!-- Chips added programmatically -->
            </com.google.android.material.chip.ChipGroup>

            <!-- Price Range -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price Range (per month)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/rs_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="100000"
                android:stepSize="1000"
                app:values="@array/initial_slider_values"
                app:labelBehavior="withinBounds"
                android:layout_marginBottom="8dp"/>
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_min_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0"
                    android:textColor="@color/on_surface_secondary"/>
                <TextView
                    android:id="@+id/tv_max_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="100,000+"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/on_surface_secondary"/>
            </LinearLayout>

            <!-- Bedrooms -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bedrooms"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_bedrooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                android:layout_marginBottom="20dp">
                
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bed_any"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Any"
                    android:checked="true"
                    style="@style/Widget.RentalApp.Chip"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bed_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    style="@style/Widget.RentalApp.Chip"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bed_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    style="@style/Widget.RentalApp.Chip"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bed_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    style="@style/Widget.RentalApp.Chip"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bed_4plus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4+"
                    style="@style/Widget.RentalApp.Chip"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- Furnishing -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/furnished_status"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_furnished"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true">
                
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_furn_any"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Any"
                    android:checked="true"
                    style="@style/Widget.RentalApp.Chip"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_furn_fully"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fully Furnished"
                    style="@style/Widget.RentalApp.Chip"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_furn_semi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semi Furnished"
                    style="@style/Widget.RentalApp.Chip"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_furn_un"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unfurnished"
                    style="@style/Widget.RentalApp.Chip"/>
            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_apply_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_bg"
        android:text="@string/apply_filters"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

</LinearLayout>
