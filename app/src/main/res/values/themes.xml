<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.HouseRentalApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dark_orange</item>
        <item name="colorSecondaryVariant">@color/orange_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:colorBackground">@color/surface_variant</item>
        <item name="colorOnBackground">@color/on_surface</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/surface_variant</item>

        <!-- Text -->
        <item name="android:textColor">@color/on_surface</item>

        <!-- Bottom Navigation -->
        <item name="bottomNavigationStyle">@style/Widget.RentalApp.BottomNavigation</item>

        <!-- Card -->
        <item name="materialCardViewStyle">@style/Widget.RentalApp.Card</item>

        <!-- EditText -->
        <item name="editTextStyle">@style/Widget.RentalApp.EditText</item>

        <!-- Circle image border -->
        <item name="civ_border_color">@color/primary</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.RentalApp.BottomNavigation"
        parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.RentalApp.Card"
        parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- EditText Style -->
    <style name="Widget.RentalApp.EditText"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Custom Text Appearances -->
    <style name="TextAppearance.RentalApp" parent="TextAppearance.MaterialComponents.Body1" />

    <!-- Text Appearances -->
    <style name="TextAppearance.RentalApp.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.RentalApp.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.RentalApp.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/on_surface_secondary</item>
    </style>

    <style name="TextAppearance.RentalApp.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/dark_grey</item>
    </style>

    <style name="TextAppearance.RentalApp.Price">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/dark_orange</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.RentalApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.RentalApp.Button.Outlined"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Chip Style for Amenities / Filters -->
    <style name="Widget.RentalApp.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <!-- Toolbar Style -->
    <style name="Widget.RentalApp.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/on_surface</item>
        <item name="navigationIconTint">@color/on_surface</item>
    </style>

    <!-- Status badge styles -->
    <!-- Base Badge Style -->
    <style name="Badge">
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Badge.Pending" parent="Badge">
        <item name="android:background">@drawable/bg_badge_pending</item>
        <item name="android:textColor">@color/status_pending</item>
    </style>

    <style name="Badge.Confirmed" parent="Badge">
        <item name="android:background">@drawable/bg_badge_confirmed</item>
        <item name="android:textColor">@color/status_active</item>
    </style>

    <style name="Badge.Rejected" parent="Badge">
        <item name="android:background">@drawable/bg_badge_rejected</item>
        <item name="android:textColor">@color/status_rejected</item>
    </style>
</resources>